# Reference only: Uvicorn does not load this file automatically.
FIREBASE_PROJECT_ID=speed-demon-d6581
FIREBASE_CREDENTIALS_FILE=/etc/secrets/firebase-credentials.json
ALLOWED_ORIGINS=https://speed-demons.vercel.app,http://localhost:5500,http://127.0.0.1:5500
RESULT_OUTBOX_PATH=/tmp/speed-demon-results.sqlite3
# Security defaults and policy naming: docs/SECURITY.md
# Local/direct mode. Render public web services can use render-cloudflare.
# See docs/SECURITY.md for the required ingress/private-network trust boundary.
SD_CLIENT_IP_MODE=proxy-cidrs
# Keep Uvicorn --no-proxy-headers; never substitute Render outbound ranges.
SD_TRUSTED_PROXY_CIDRS=
SD_MAX_CONNECTIONS=2000
SD_MAX_CONNECTIONS_PER_IP=32
SD_MAX_ROOMS=1000
SD_MAX_ROUNDS=1000
SD_MAX_RATE_KEYS=20000
SD_WS_MESSAGE_BYTES=16384
SD_HTTP_BODY_BYTES=4096
SD_HTTP_BODY_SECONDS=10
SD_SOCKET_IDLE_SECONDS=900
SD_UNJOINED_SECONDS=120
SD_ROOM_IDLE_SECONDS=900
SD_MAINTENANCE_SECONDS=30
# Example policy override (all defaults are listed in docs/SECURITY.md):
# SD_RATE_JOIN_IP_LIMIT=120
# SD_RATE_JOIN_IP_SECONDS=60
